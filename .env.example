# 服务只监听本机；如需修改端口，请复制为 .env 后调整。
GOPAY_HOST=127.0.0.1
GOPAY_PORT=19081
GOPAY_DATABASE_PATH=data/app.db
GOPAY_SESSION_TTL_HOURS=168
GOPAY_COOKIE_SECURE=false
GOPAY_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
GOPAY_ALLOWED_ORIGINS=http://127.0.0.1:19081,http://localhost:19081
GOPAY_WORKER_COUNT=8
GOPAY_WORKER_LEASE_SECONDS=60
GOPAY_WORKER_HEARTBEAT_SECONDS=10
GOPAY_WORKER_POLL_SECONDS=0.25
GOPAY_WORKER_SHUTDOWN_SECONDS=30
GOPAY_TASK_RETRY_BASE_SECONDS=2
GOPAY_CHANGE_LOG_LIMIT=10000
GOPAY_SSE_POLL_SECONDS=0.5
GOPAY_SSE_HEARTBEAT_SECONDS=15
# 核心注册成功后，独立后台任务等待系统奖励余额的时长与轮询间隔。
GOPAY_POST_REGISTER_BALANCE_WAIT_SECONDS=180
GOPAY_POST_REGISTER_BALANCE_POLL_SECONDS=10
GOPAY_LEGACY_APP_PATH=../app
GOPAY_LOG_LEVEL=INFO
